exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n55" target="n61"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n81" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#C50F1F;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#59666F;labelBackgroundColor=#FFFFFF;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n61" target="n67"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n82" value="Webhook side door — anonymous BY DESIGN (Event Grid cannot send auth headers) … so it gets its own guards" style="rounded=1;arcSize=4;fillColor=#FDF0F1;strokeColor=#C50F1F;verticalAlign=top;align=left;spacing=12;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#24292F;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="900" height="120" as="geometry" /></mxCell><mxCell id="n83" value="&lt;b style=&quot;font-size:11px&quot;&gt;OPTIONS handshake&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;CloudEvents abuse-protection&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C50F1F;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=9;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="85" y="630" width="200" height="50" as="geometry" /></mxCell><mxCell id="n84" value="&lt;b style=&quot;font-size:11px&quot;&gt;WEBHOOK_SECRET&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;query-key check&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C50F1F;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=9;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="315" y="630" width="200" height="50" as="geometry" /></mxCell><mxCell id="n85" value="&lt;b style=&quot;font-size:11px&quot;&gt;subject masking&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;PII masked before audit log&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C50F1F;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=9;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="545" y="630" width="200" height="50" as="geometry" /></mxCell><mxCell id="n86" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#C50F1F;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#59666F;labelBackgroundColor=#FFFFFF;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n83" target="n84"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n87" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#C50F1F;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#59666F;labelBackgroundColor=#FFFFFF;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n84" target="n85"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n88" value="WebhookEndpoints.cs — /hooks/events" style="text;html=1;fontSize=8;fontColor=#8A949E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="770" y="645" width="170" height="30" as="geometry" /></mxCell><mxCell id="n89" value="&lt;b style=&quot;font-size:11px&quot;&gt;scope vocabulary (TypeSpec @useAuth · PlatformScopes.cs)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;account.read · account.detailed.read (PII gate) · transaction.read ·&lt;br&gt;customer.read · contact.read (PII gate) · event.publish&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C50F1F;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1000" y="605" width="900" height="90" as="geometry" /></mxCell><mxCell id="n90" value="The same rules, enforced three times — you cannot merge, run, or ship around them" style="rounded=1;arcSize=4;fillColor=#F6EFFC;strokeColor=#7B2FBE;verticalAlign=top;align=left;spacing=12;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#24292F;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="750" width="1840" height="260" as="geometry" /></mxCell><mxCell id="n91" value="&lt;b style=&quot;font-size:11px&quot;&gt;COMPILE TIME — Roslyn analyzers (all severity=error)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;APL0001 governed source registered outside a connector module · APL0002 non-public module ·&lt;br&gt;APL0003 DateTime.Now (use TimeProvider) · APL0004 Console.Write (use ILogger) ·&lt;br&gt;APL0005 Problem() without type · RS0030 raw HttpClient/SqlConnection/DbContext outside Integration&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7B2FBE;verticalAlign=top;align=left;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="90" y="800" width="570" height="150" as="geometry" /></mxCell><mxCell id="n92" value="&lt;b style=&quot;font-size:11px&quot;&gt;RUNTIME — governance proxy&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;GovernSources() wraps every IGovernedSource in Castle DynamicProxy —&lt;br&gt;keyed on the type relationship, not namespace convention.&lt;br&gt;OTel span + audit record + PII arg-masking on every call.&lt;br&gt;Sensitive param names (ssn·dob·email·account·member…) ⇒ redactor&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7B2FBE;verticalAlign=top;align=left;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="690" y="800" width="570" height="150" as="geometry" /></mxCell><mxCell id="n93" value="&lt;b style=&quot;font-size:11px&quot;&gt;TEST TIME — fitness functions&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;NetArchTest ×9: dependency direction is law (Platform ⊬ AspNetCore, Contracts leaf…) ·&lt;br&gt;vendor sources internal · seams implement IGovernedSource ·&lt;br&gt;GoldenPathGovernanceTests (DoD): PII absent over HTTP without scope ·&lt;br&gt;no-scope ⇒ 401/403 · off-path hosts still audit+mask · drift gate on the spec&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7B2FBE;verticalAlign=top;align=left;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1290" y="800" width="580" height="150" as="geometry" /></mxCell><mxCell id="n94" value="an engineer cannot add a data source that bypasses audit: the analyzer blocks the merge, the proxy wraps it anyway, the tests fail the build" style="text;html=1;fontSize=10;fontColor=#7B2FBE;align=left;verticalAlign=top;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="90" y="960" width="1500" height="20" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page5" name="04 · Contract-first &amp; CI/CD"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1100" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Contract-first &amp; CI/CD — TypeSpec is law, the pipeline is the courtroom&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:12px&quot;&gt;spec → emit → lint → drift-gate → conformance · build once, promote byte-for-byte, approvals not branches&lt;/font&gt;" style="text;html=1;fontSize=12;fontColor=#24292F;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1300" height="60" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontSize=11;fontColor=#24292F;align=left;verticalAlign=top;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1360" y="18" width="560" height="18" as="geometry" /></mxCell><mxCell id="n3" value="" style="shape=line;html=1;strokeWidth=2;strokeWidth=1.5;strokeColor=#7A8691" vertex="1" parent="1"><mxGeometry x="1360" y="46" width="34" height="8" as="geometry" /></mxCell><mxCell id="n4" value="required / always fires" style="text;html=1;fontSize=10;fontColor=#59666F;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1400" y="40" width="150" height="18" as="geometry" /></mxCell><mxCell id="n5" value="" style="shape=line;html=1;strokeWidth=2;strokeWidth=1.5;strokeColor=#7A8691;dashed=1;dashPattern=8 4" vertex="1" parent="1"><mxGeometry x="1550" y="46" width="34" height="8" as="geometry" /></mxCell><mxCell id="n6" value="optional · config-gated" style="text;html=1;fontSize=10;fontColor=#59666F;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1590" y="40" width="150" height="18" as="geometry" /></mxCell><mxCell id="n7" value="" style="shape=line;html=1;strokeWidth=2;strokeWidth=1.2;strokeColor=#8A949E;dashed=1;dashPattern=2 3" vertex="1" parent="1"><mxGeometry x="1740" y="46" width="34" height="8" as="geometry" /></mxCell><mxCell id="n8" value="stub · future · planned seam" style="text;html=1;fontSize=10;fontColor=#59666F;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1780" y="40" width="150" height="18" as="geometry" /></mxCell><mxCell id="n9" value="" style="shape=line;html=1;strokeWidth=2;strokeWidth=2;strokeColor=#C25400;dashed=1;dashPattern=10 4" vertex="1" parent="1"><mxGeometry x="1360" y="68" width="34" height="8" as="geometry" /></mxCell><mxCell id="n10" value="scale signal / growth path" style="text;html=1;fontSize=10;fontColor=#59666F;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1400" y="62" width="150" height="18" as="geometry" /></mxCell><mxCell id="n11" value="" style="shape=line;html=1;strokeWidth=2;strokeWidth=2;strokeColor=#C50F1F" vertex="1" parent="1"><mxGeometry x="1550" y="68" width="34" height="8" as="geometry" /></mxCell><mxCell id="n12" value="security control" style="text;html=1;fontSize=10;fontColor=#59666F;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1590" y="62" width="150" height="18" as="geometry" /></mxCell><mxCell id="n13" value="" style="shape=line;html=1;strokeWidth=2;strokeWidth=1.5;strokeColor=#7B2FBE;dashed=1;dashPattern=8 4" vertex="1" parent="1"><mxGeometry x="1740" y="68" width="34" height="8" as="geometry" /></mxCell><mxCell id="n14" value="governance / audit" style="text;html=1;fontSize=10;fontColor=#59666F;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1780" y="62" width="150" height="18" as="geometry" /></mxCell><mxCell id="n15" value="TypeSpec — single source of truth (spec/)" style="rounded=1;arcSize=4;fillColor=#EFF8EF;strokeColor=#107C10;verticalAlign=top;align=left;spacing=12;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#24292F;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1880" height="310" as="geometry" /></mxCell><mxCell id="n16" value="&lt;b style=&quot;font-size:11px&quot;&gt;spec/*.tsp&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;main · accounts · customers · workitems ·&lt;br&gt;insights · events · streaming · errors · models&lt;br&gt;@versioned · @useAuth OAuth2 client-creds + 6 scopes&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#107C10;fontStyle=1;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="165" width="300" height="110" as="geometry" /></mxCell><mxCell id="n17" value="&lt;b style=&quot;font-size:11px&quot;&gt;tsp compile&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;make spec&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#107C10;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="410" y="185" width="130" height="60" as="geometry" /></mxCell><mxCell id="n18" value="&lt;b style=&quot;font-size:11px&quot;&gt;openapi.v1.yaml (3.1) + JSON Schema&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;spec/tsp-output — generated, never hand-edited&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#107C10;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="580" y="185" width="300" height="60" as="geometry" /></mxCell><mxCell id="n19" value="&lt;b style=&quot;font-size:11px&quot;&gt;Spectral lint&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;kebab-case plural paths · /v&amp;lt;major&amp;gt; · operationId ·&lt;br&gt;4xx/5xx must be problem+json · OAuth2 + scope required&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#107C10;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="920" y="175" width="320" height="80" as="geometry" /></mxCell><mxCell id="n20" value="&lt;b style=&quot;font-size:11px&quot;&gt;DRIFT GATE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;boots API on :5081 · captures /openapi/v1.json ·&lt;br&gt;diffs vs emitted spec — code ≠ contract ⇒ build fails&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FDF0F1;strokeColor=#C50F1F;fontStyle=1;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1280" y="175" width="330" height="80" as="geometry" /></mxCell><mxCell id="n21" value="&lt;b style=&quot;font-size:11px&quot;&gt;Redocly portal&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;build-portal.sh → blob static site&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#107C10;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1650" y="165" width="240" height="56" as="geometry" /></mxCell><mxCell id="n22" value="&lt;b style=&quot;font-size:11px&quot;&gt;Prism mock&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;npm run mock — consumers build before you do&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#107C10;dashed=1;dashPattern=6 4;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1650" y="240" width="240" height="56" as="geometry" /></mxCell><mxCell id="n23" value="&lt;b style=&quot;font-size:11px&quot;&gt;schemathesis&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;property-based conformance vs the spec&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#107C10;dashed=1;dashPattern=6 4;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1280" y="280" width="330" height="56" as="geometry" /></mxCell><mxCell id="n24" value="runtime endpoint /openapi/v1.json is mapped unconditionally —&lt;br&gt;so the drift gate and tests can always see the truth" style="text;html=1;fontSize=9;fontColor=#107C10;align=lef