nt-size:9px&quot;&gt;tools/sanitize.sh — structural regex gate:&lt;br&gt;no Fox/vendor identifiers may land public&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FDF0F1;strokeColor=#C50F1F;fontStyle=1;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="525" width="300" height="80" as="geometry" /></mxCell><mxCell id="n35" value="&lt;b style=&quot;font-size:11px&quot;&gt;build-test&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;restore --locked-mode · build Release · test&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C6CDD3;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="535" width="290" height="60" as="geometry" /></mxCell><mxCell id="n36" value="needs: sanitize" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#7A8691;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#59666F;labelBackgroundColor=#FFFFFF;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n34" target="n35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n37" value="the public repo is a sanitized distillation — the gate is structural, not manual review" style="text;html=1;fontSize=9;fontColor=#57606A;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="612" width="640" height="18" as="geometry" /></mxCell><mxCell id="n38" value="Azure DevOps — azure-pipelines.yml (full reference pipeline)" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#0078D4;verticalAlign=top;align=left;spacing=12;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#24292F;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1880" height="340" as="geometry" /></mxCell><mxCell id="n39" value="&lt;b style=&quot;font-size:11px&quot;&gt;BuildTest&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;restore(locked) → build → test →&lt;br&gt;tsp compile → spectral → schemathesis →&lt;br&gt;&lt;b&gt;drift gate&lt;/b&gt; → publish artifact&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#0078D4;fontStyle=1;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="740" width="300" height="110" as="geometry" /></mxCell><mxCell id="n40" value="&lt;b style=&quot;font-size:11px&quot;&gt;Scan&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#0078D4;fontStyle=1;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="410" y="740" width="320" height="110" as="geometry" /></mxCell><mxCell id="n41" value="gitleaks — &lt;b&gt;HARD gate&lt;/b&gt;" style="rounded=1;arcSize=40;fillColor=#FDF0F1;strokeColor=#C50F1F;fontSize=9;fontColor=#24292F;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="775" width="130" height="22" as="geometry" /></mxCell><mxCell id="n42" value="semgrep — advisory" style="rounded=1;arcSize=40;fillColor=#FAFBFC;strokeColor=#8A949E;fontSize=9;fontColor=#24292F;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="775" width="140" height="22" as="geometry" /></mxCell><mxCell id="n43" value="trivy fs — advisory" style="rounded=1;arcSize=40;fillColor=#FAFBFC;strokeColor=#8A949E;fontSize=9;fontColor=#24292F;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="805" width="130" height="22" as="geometry" /></mxCell><mxCell id="n44" value="org templates make these HARD" style="text;html=1;fontSize=8.5;fontColor=#59666F;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="570" y="805" width="150" height="30" as="geometry" /></mxCell><mxCell id="n45" value="&lt;b style=&quot;font-size:11px&quot;&gt;Pack&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;6 packable assemblies → NuGet feed:&lt;br&gt;Contracts · Platform · Platform.AspNetCore ·&lt;br&gt;Platform.Telemetry · ServiceDefaults · Analyzers&lt;br&gt;-ci.&amp;lt;BuildId&amp;gt; on main · clean on v* tag&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#0078D4;fontStyle=1;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="770" y="740" width="340" height="110" as="geometry" /></mxCell><mxCell id="n46" value="&lt;b style=&quot;font-size:11px&quot;&gt;DeployDev&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;Bicep sub-deploy → az acr build →&lt;br&gt;containerapp update (revision suffix) →&lt;br&gt;/health smoke · ADO Environment gated&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#EFF8EF;strokeColor=#107C10;fontStyle=1;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1150" y="740" width="320" height="110" as="geometry" /></mxCell><mxCell id="n47" value="&lt;b style=&quot;font-size:11px&quot;&gt;qa&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;✋&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C6CDD3;dashed=1;dashPattern=6 4;fontStyle=1;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1520" y="765" width="118" height="56" as="geometry" /></mxCell><mxCell id="n48" value="&lt;b style=&quot;font-size:11px&quot;&gt;staging&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;✋&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C6CDD3;dashed=1;dashPattern=6 4;fontStyle=1;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1652" y="765" width="118" height="56" as="geometry" /></mxCell><mxCell id="n49" value="&lt;b style=&quot;font-size:11px&quot;&gt;prod&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#59666F&quot; style=&quot;font-size:9px&quot;&gt;✋ VP&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C6CDD3;dashed=1;dashPattern=6 4;fontStyle=1;verticalAlign=top;align=center;spacing=6;spacingTop=2;fontSize=10;fontColor=#24292F;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1784" y="765" width="118" height="56" as="geometry" /></mxCell><mxCell id="n50" value="Azure Artifacts (NuGet feed)" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=9;fontColor=#24292F;labelBackgroundColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="900" y="900" width="44" height="44" as="geometry" /></mxCell><mxCell id="n51" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#7A8691;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#59666F;labelBackgroundColor=#FFFFFF;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n39" target="n40"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n52" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#7A8691;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#59666F;labelBackgroundColor=#FFFFFF;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n40" target="n45"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n53" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#7A8691;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#59666F;labelBackgroundColor=#FFFFFF;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n45" target="n46"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n54" value="push" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#7A8691;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#59666F;labelBackgroundColor=#FFFFFF;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n45" target="n50"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n55" value="same artifact" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#7A8691;dashed=1;dashPattern=8 4;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#59666F;labelBackgroundColor=#FFFFFF;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n46" target="n47"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n56" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#7A8691;dashed=1;dashPattern=8 4;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#59666F;labelBackgroundColor=#FFFFFF;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n47" target="n48"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n57" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;jettySize=auto;orthogonalLoop=1;stroke