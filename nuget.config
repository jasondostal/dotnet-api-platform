<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Consumers of the published packages add the Azure Artifacts feed as a source and
         authenticate (CI: NuGetAuthenticate@1; local: az + the Azure Artifacts credential provider).
         Feed URL shape: https://pkgs.dev.azure.com/<your-ado-org>/<project>/_packaging/<feed>/nuget/v3/index.json
         nuget.org is kept as the upstream so the platform builds clones-and-runs offline. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
