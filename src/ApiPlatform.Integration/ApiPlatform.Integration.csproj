<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vendor-private types (e.g. the unwired Databricks live client) stay internal;
         the test assembly is allowed to construct them for diagnostics. -->
    <InternalsVisibleTo Include="ApiPlatform.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApiPlatform.Contracts\ApiPlatform.Contracts.csproj" />
    <ProjectReference Include="..\ApiPlatform.Platform\ApiPlatform.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Universal audit/trace interception over every vendor source (read + write). -->
    <PackageReference Include="Castle.Core" />
    <PackageReference Include="Castle.Core.AsyncInterceptor" />
  </ItemGroup>

  <ItemGroup>
    <!-- Eventing connectors (Azure kept). Publishers are config-selected and default to
         an in-memory publisher when no connection string is present (clones-and-runs offline). -->
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="Azure.Messaging.EventGrid" />
  </ItemGroup>

</Project>
