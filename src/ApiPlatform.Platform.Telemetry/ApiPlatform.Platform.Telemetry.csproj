<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>ApiPlatform.Platform.Telemetry</PackageId>
    <Description>OpenTelemetry setup for non-web platform hosts (Poller, EventSource, MCP). Wires the platform ActivitySource and a service resource; exporter is an opt-in config hook.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApiPlatform.Platform\ApiPlatform.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

</Project>
